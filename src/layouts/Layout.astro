---
import { ClientRouter } from "astro:transitions";
import { PUBLIC_GOOGLE_SITE_VERIFICATION } from "astro:env/client";
import { SITE } from "@/config";
import {
  HTML_LANG,
  OG_LOCALE,
  getLocaleFromPath,
  localizePath,
  stripLocale,
  type Locale,
} from "@/i18n/locale";
import { t } from "@/i18n/ui";
import GoogleAnalytics from "@/components/GoogleAnalytics.astro";
import "@/styles/global.css";

export interface Props {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  alternates?: Partial<Record<Locale, string>> | null;
}

const {
  title = SITE.title,
  author = SITE.author,
  profile = SITE.profile,
  description = t(getLocaleFromPath(Astro.url.pathname), "site.desc"),
  ogImage = SITE.ogImage ? `/${SITE.ogImage}` : "/og.png",
  canonicalURL = new URL(Astro.url.pathname, Astro.url),
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  alternates,
} = Astro.props;

const locale = getLocaleFromPath(Astro.url.pathname);
const barePath = stripLocale(Astro.url.pathname);
const defaultAlternates: Record<Locale, string> = {
  en: localizePath(barePath, "en"),
  "zh-tw": localizePath(barePath, "zh-tw"),
};
const resolvedAlternates =
  alternates === null ? null : (alternates ?? defaultAlternates);
const alternateEntries = resolvedAlternates
  ? (["en", "zh-tw"] as const)
      .filter(l => resolvedAlternates[l])
      .map(l => [l, resolvedAlternates[l] as string] as const)
  : [];
const toAbsolute = (path: string) =>
  new URL(path, Astro.site ?? Astro.url).href;
const otherLocale: Locale = locale === "en" ? "zh-tw" : "en";

const socialImageURL = new URL(ogImage, Astro.url);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: `${title}`,
  image: `${socialImageURL}`,
  datePublished: `${pubDatetime?.toISOString()}`,
  ...(modDatetime && { dateModified: modDatetime.toISOString() }),
  inLanguage: HTML_LANG[locale],
  author: [
    {
      "@type": "Person",
      name: `${author}`,
      ...(profile && { url: profile }),
    },
  ],
};
---

<!doctype html>
<html
  dir={SITE.dir}
  lang={HTML_LANG[locale]}
  class={`${scrollSmooth && "scroll-smooth"}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="icon"
      type="image/png"
      href="/icons/favicon.png"
      sizes="512x512"
    />
    <link
      rel="icon"
      type="image/x-icon"
      href="/icons/favicon.ico"
      sizes="32x32"
    />
    <link
      rel="icon"
      type="image/png"
      href="/icons/favicon-16x16.png"
      sizes="16x16"
    />
    <link
      rel="icon"
      type="image/png"
      href="/icons/favicon-32x32.png"
      sizes="32x32"
    />
    <link
      rel="apple-touch-icon"
      href="/icons/apple-touch-icon.png"
      sizes="180x180"
    />
    <link rel="manifest" href="/icons/site.webmanifest" />
    <meta name="msapplication-TileColor" content="#da532c" />
    <link rel="canonical" href={canonicalURL} />
    {
      alternateEntries.map(([altLocale, path]) => (
        <link
          rel="alternate"
          hreflang={HTML_LANG[altLocale]}
          href={toAbsolute(path)}
        />
      ))
    }
    {
      resolvedAlternates?.en && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={toAbsolute(resolvedAlternates.en)}
        />
      )
    }
    <meta name="generator" content={Astro.generator} />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {
      alternateEntries.some(([altLocale]) => altLocale === otherLocale) && (
        <meta property="og:locale:alternate" content={OG_LOCALE[otherLocale]} />
      )
    }

    <!-- Article Published/Modified time -->
    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- Google JSON-LD Structured data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />

    <!-- Enable RSS feed auto-discovery  -->
    <!-- https://docs.astro.build/en/recipes/rss/#enabling-rss-feed-auto-discovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t(locale, "rss.title")}
      href={new URL(
        locale === "zh-tw" ? "zh-tw/rss.xml" : "rss.xml",
        Astro.site
      )}
    />

    <meta name="theme-color" content="" />

    {
      // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
      // include google-site-verification tag in the heading
      // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
      PUBLIC_GOOGLE_SITE_VERIFICATION && (
        <meta
          name="google-site-verification"
          content={PUBLIC_GOOGLE_SITE_VERIFICATION}
        />
      )
    }

    <!-- Google Analytics -->
    <GoogleAnalytics />

    <ClientRouter />

    <script is:inline src="/toggle-theme.js"></script>

    <!-- Shared classic-script loader for per-component CDN libs.
      UMD bundles fail when injected as <script type="module"> (strict-mode
      `this` is undefined inside their factories), so fetch pinned source and
      evaluate it non-strictly with `window` as `this`. Dedupes in-flight and
      completed loads per URL; sequential awaits order dependent scripts. -->
    <script is:inline>
      window.__classicScripts = window.__classicScripts || {};
      window.loadClassicScript = function (src) {
        window.__classicScripts[src] =
          window.__classicScripts[src] ||
          fetch(src)
            .then(function (r) {
              if (!r.ok) throw new Error(src + ": HTTP " + r.status);
              return r.text();
            })
            .then(function (code) {
              new Function(code).call(new Function("return this")());
            });
        return window.__classicScripts[src];
      };
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
