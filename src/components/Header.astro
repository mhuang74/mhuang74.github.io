---
import Hr from "./Hr.astro";
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import LinkButton from "./LinkButton.astro";
import {
  getLocaleFromPath,
  HTML_LANG,
  localizePath,
  stripLocale,
  switchLocalePath,
  type Locale,
} from "@/i18n/locale";
import { t } from "@/i18n/ui";
import { SITE } from "@/config";

export interface Props {
  switchHref?: string;
}

const { pathname } = Astro.url;
const locale = getLocaleFromPath(pathname);
const otherLocale: Locale = locale === "en" ? "zh-tw" : "en";
const { switchHref = switchLocalePath(pathname) } = Astro.props;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;
const bareCurrentPath = stripLocale(currentPath);

const isActive = (path: string) => {
  const currentPathArray = bareCurrentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return bareCurrentPath === path || currentPathArray[0] === pathArray[0];
};
---

<header>
  <a
    id="skip-to-content"
    href="#main-content"
    class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
  >
    {t(locale, "nav.skipToContent")}
  </a>
  <div
    id="nav-container"
    class="mx-auto flex max-w-app flex-col items-center justify-between sm:flex-row"
  >
    <div
      id="top-nav-wrap"
      class="relative flex min-h-26 w-full items-baseline justify-between bg-background p-4 sm:min-h-0 sm:items-center sm:py-6"
    >
      <a
        href={localizePath("/", locale)}
        class="absolute flex items-center gap-2 py-1 text-xl leading-8 font-semibold whitespace-nowrap sm:static sm:my-auto sm:text-2xl sm:leading-none"
      >
        <img
          src="/icons/favicon.png"
          alt=""
          class="h-16 w-16 sm:h-20 sm:w-20"
          aria-hidden="true"
        />
        <span>{SITE.title}</span>
      </a>
      <nav
        id="nav-menu"
        class="flex w-full flex-col items-center sm:ms-2 sm:flex-row sm:justify-end sm:space-x-4 sm:py-0"
      >
        <button
          id="menu-btn"
          class="focus-outline self-end p-2 sm:hidden"
          aria-label={t(locale, "nav.openMenu")}
          aria-expanded="false"
          aria-controls="menu-items"
        >
          <IconX id="close-icon" class="hidden" />
          <IconMenuDeep id="menu-icon" />
        </button>
        <ul
          id="menu-items"
          class:list={[
            "mt-4 grid w-44 grid-cols-2 place-content-center gap-2",
            "[&>li>a]:block [&>li>a]:px-4 [&>li>a]:py-3 [&>li>a]:text-center [&>li>a]:font-medium [&>li>a]:hover:text-accent sm:[&>li>a]:px-2 sm:[&>li>a]:py-1",
            "hidden",
            "sm:mt-0 sm:flex sm:w-auto sm:gap-x-5 sm:gap-y-0",
          ]}
        >
          <li class="col-span-2">
            <a
              href={localizePath("/work", locale)}
              class:list={{ "active-nav": isActive("/work") }}
            >
              {t(locale, "nav.work")}
            </a>
          </li>
          <li class="col-span-2">
            <a
              href={localizePath("/posts", locale)}
              class:list={{ "active-nav": isActive("/posts") }}
            >
              {t(locale, "nav.writing")}
            </a>
          </li>
          <li class="col-span-2">
            <a
              href={localizePath("/about", locale)}
              class:list={{ "active-nav": isActive("/about") }}
            >
              {t(locale, "nav.about")}
            </a>
          </li>
          <li class="col-span-2">
            <a
              href={switchHref}
              hreflang={HTML_LANG[otherLocale]}
              lang={HTML_LANG[otherLocale]}
              class="font-medium"
              aria-label={t(
                locale,
                otherLocale === "zh-tw"
                  ? "nav.switchToChinese"
                  : "nav.switchToEnglish"
              )}
            >
              {
                t(
                  locale,
                  otherLocale === "zh-tw"
                    ? "nav.switchLabelChinese"
                    : "nav.switchLabelEnglish"
                )
              }
            </a>
          </li>
          <li class="col-span-1 flex items-center justify-center">
            <LinkButton
              href={localizePath("/search", locale)}
              class:list={[
                "focus-outline flex p-3 sm:p-1",
                { "[&>svg]:stroke-accent": isActive("/search") },
              ]}
              ariaLabel={t(locale, "nav.search")}
              title={t(locale, "nav.search")}
            >
              <IconSearch />
              <span class="sr-only">{t(locale, "nav.search")}</span>
            </LinkButton>
          </li>
          {
            SITE.lightAndDarkMode && (
              <li class="col-span-1 flex items-center justify-center">
                <button
                  id="theme-btn"
                  class="focus-outline relative size-12 p-4 sm:size-8 hover:[&>svg]:stroke-accent"
                  title={t(locale, "nav.toggleTheme")}
                  aria-label="auto"
                  aria-live="polite"
                >
                  <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                  <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
                </button>
              </li>
            )
          }
        </ul>
      </nav>
    </div>
  </div>
  <Hr />
</header>

<script>
  import { getLocaleFromPath } from "@/i18n/locale";
  import { t } from "@/i18n/ui";

  function toggleNav() {
    const menuBtn = document.querySelector("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";
      const locale = getLocaleFromPath(location.pathname);

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute(
        "aria-label",
        t(locale, openMenu ? "nav.openMenu" : "nav.closeMenu")
      );

      menuItems.classList.toggle("hidden");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  toggleNav();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", toggleNav);
</script>
