---
import Layout from "@/layouts/Layout.astro";
import Footer from "@/components/Footer.astro";
import { getCollection } from "astro:content";
import { SOCIALS } from "@/constants";
import { landingContent } from "@/i18n/landing";
import {
  HTML_LANG,
  localizePath,
  switchLocalePath,
  type Locale,
} from "@/i18n/locale";
import { t } from "@/i18n/ui";
import { getWorkHref } from "@/utils/entryPath";

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const otherLocale: Locale = locale === "en" ? "zh-tw" : "en";
const switchLabel = t(
  locale,
  otherLocale === "zh-tw" ? "nav.switchLabelChinese" : "nav.switchLabelEnglish"
);
const switchAria = t(
  locale,
  otherLocale === "zh-tw" ? "nav.switchToChinese" : "nav.switchToEnglish"
);

const { meta, hero, stats, flagship, moreWork, experience, writing, contact } =
  landingContent[locale];
const { eyebrow: principlesEyebrow, heading: principlesHeading } =
  landingContent[locale].principles;
const decisions = flagship.decisions;
const sowStack = flagship.stack;
const projects = moreWork.projects;
const principles = landingContent[locale].principles.items;
const timeline = experience.rows;
const posts = writing.posts;

const works =
  locale === "zh-tw"
    ? await getCollection("workZhTw")
    : await getCollection("work");
const workHrefs = new Map(works.map(w => [w.data.title, getWorkHref(w)]));

const linkedinHref = SOCIALS.find(s => s.name === "LinkedIn")!.href;
---

<Layout title={meta.title} description={meta.description}>
  <header class="lang-bar">
    <a
      href={switchLocalePath(Astro.url.pathname)}
      hreflang={HTML_LANG[otherLocale]}
      lang={HTML_LANG[otherLocale]}
      aria-label={switchAria}>{switchLabel}</a
    >
  </header>
  <!-- hero -->
  <section class="pl-hero" data-od-id="hero">
    <div class="pl-hero-split">
      <div>
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1>{hero.headline}</h1>
        <p class="lead">{hero.lead}</p>
        <div class="cta-row">
          <a
            class="btn-primary"
            href={linkedinHref}
            target="_blank"
            rel="noopener noreferrer"
            data-od-id="hero-cta-linkedin"
            data-cta="linkedin"
            data-cta-location="hero">{hero.ctaPrimary}</a
          >
          <a class="btn-ghost" href="#work">{hero.ctaGhost}</a>
        </div>
        <p class="note">{hero.note}</p>
      </div>
      <div class="portrait-frame">
        <img
          class="portrait"
          src="/portrait.jpg"
          width="640"
          height="640"
          alt={hero.portraitAlt}
        />
        <span class="portrait-chip">{hero.chip}</span>
      </div>
    </div>
  </section>

  <!-- proof -->
  <section class="pl-section" data-od-id="stats">
    <p class="eyebrow">{stats.eyebrow}</p>
    <div class="stats">
      {
        stats.items.map(s => (
          <div class="stat">
            <div class="stat-num">
              {s.num}
              <span class="stat-unit">{s.unit}</span>
            </div>
            <p class="stat-label">{s.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- flagship -->
  <section class="pl-section" id="work" data-od-id="work-feature">
    <div class="work-split">
      <div>
        <p class="eyebrow">{flagship.eyebrow}</p>
        <h2>{flagship.title}</h2>
        <p class="lead">{flagship.lead}</p>
        <a class="btn-ghost" href={workHrefs.get("Stream of Worship")}
          >{flagship.linkLabel}</a
        >
        <ul class="decisions">
          {
            decisions.map(([head, body]) => (
              <li>
                <strong>{head}</strong> {body}
              </li>
            ))
          }
        </ul>
      </div>
      <aside class="facts" data-od-id="work-facts">
        <dl>
          <div>
            <dt>{t(locale, "work.role")}</dt><dd>{flagship.facts.role}</dd>
          </div>
          <div>
            <dt>{t(locale, "work.team")}</dt><dd>{flagship.facts.team}</dd>
          </div>
          <div>
            <dt>{t(locale, "work.scale")}</dt><dd>
              {flagship.facts.scale}
            </dd>
          </div>
          <div>
            <dt>{t(locale, "work.stack")}</dt>
            <dd class="tag-row">
              {sowStack.map(t => <span class="tag">{t}</span>)}
            </dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <!-- more work -->
  <section class="pl-section" data-od-id="more-work">
    <p class="eyebrow">{moreWork.eyebrow}</p>
    <h2>{moreWork.heading}</h2>
    <div class="work-grid">
      {
        projects.map(p => (
          <a class="work-card" href={workHrefs.get(p.title)}>
            <span class="pill">{p.pill}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
            <p class="metric">{p.metric}</p>
            <div class="tag-row">
              {p.tags.map(t => (
                <span class="tag">{t}</span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- how I work -->
  <section class="pl-section" data-od-id="principles">
    <p class="eyebrow">{principlesEyebrow}</p>
    <h2>{principlesHeading}</h2>
    <div class="feature-grid">
      {
        principles.map(([head, body]) => (
          <div class="feature">
            <h3>{head}</h3>
            <p>{body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- experience -->
  <section class="pl-section" id="experience" data-od-id="experience">
    <p class="eyebrow">{experience.eyebrow}</p>
    <h2>
      {experience.heading}
    </h2>
    <div class="log">
      {
        timeline.map(r => (
          <article class="log-row">
            <span class="meta">{r.when}</span>
            <div>
              <h3>{r.role}</h3>
              <p class="dek">{r.dek}</p>
            </div>
            <span class="meta pull">{r.pull}</span>
          </article>
        ))
      }
    </div>
  </section>

  <!-- writing -->
  <section class="pl-section" id="writing" data-od-id="writing">
    <div class="head-row">
      <div>
        <p class="eyebrow">{writing.eyebrow}</p>
        <h2>{writing.heading}</h2>
      </div>
      <a class="btn-ghost" href={localizePath("/posts", locale)}
        >{writing.linkLabel}</a
      >
    </div>
    <div class="log">
      {
        posts.map(p => (
          <article class="log-row">
            <span class="meta">{p.date}</span>
            <div>
              <h3>
                <a href={p.href}>{p.title}</a>
              </h3>
              <p class="dek">{p.dek}</p>
            </div>
            <span class="meta pull">{p.pull}</span>
          </article>
        ))
      }
    </div>
  </section>

  <!-- cta -->
  <section class="pl-section cta-strip" id="contact" data-od-id="cta-strip">
    <p class="eyebrow">{contact.eyebrow}</p>
    <h2>{contact.heading}</h2>
    <p
      class="lead"
      set:html={contact.lead.replace(
        "michael@michaelhuang.xyz",
        '<a href="mailto:michael@michaelhuang.xyz">michael@michaelhuang.xyz</a>'
      )}
    />
    <a
      class="btn-primary"
      href={linkedinHref}
      target="_blank"
      rel="noopener noreferrer"
      data-od-id="cta-linkedin"
      data-cta="linkedin"
      data-cta-location="cta-strip">{contact.cta}</a
    >
  </section>
  <Footer />
</Layout>

<script>
  // GA4 event tracking for CTA clicks. The site's GA bootstrap (GoogleAnalytics.astro)
  // is IIFE-wrapped, so `gtag` is not exposed on window; define the snippet-standard
  // shim locally. gtag.js's dataLayer handler only dispatches Arguments objects
  // (an array is read as a dotted model path and never fires), so the regular
  // function + `arguments` form is required — `dataLayer.push(["event", …])` would
  // silently no-op.
  type DlWindow = Window & { __ctaClickWired?: boolean; dataLayer?: unknown[] };
  const dlWindow = window as DlWindow;
  if (!dlWindow.__ctaClickWired) {
    dlWindow.__ctaClickWired = true;
    // eslint-disable-next-line @typescript-eslint/no-unused-vars -- rest param exists only to allow the 3-arg call
    function gtag(..._args: unknown[]): void {
      // eslint-disable-next-line prefer-rest-params -- Arguments object is the required message form for gtag.js
      (dlWindow.dataLayer = dlWindow.dataLayer || []).push(arguments);
    }
    document.addEventListener("click", e => {
      const el = (e.target as Element | null)?.closest?.("[data-cta]");
      if (!el) return;
      gtag("event", "cta_click", {
        target: el.getAttribute("data-cta"),
        location: el.getAttribute("data-cta-location"),
      });
    });
  }
</script>

<style>
  .lang-bar {
    max-width: 1120px;
    margin-inline: auto;
    padding: 20px 32px 0;
    display: flex;
    justify-content: flex-end;
  }
  .lang-bar a {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 13px;
    color: color-mix(in oklch, var(--foreground) 80%, transparent);
    text-decoration: none;
  }
  .lang-bar a:hover {
    color: var(--accent);
  }
  .pl-hero,
  .pl-section {
    max-width: 1120px;
    margin-inline: auto;
    padding-inline: 32px;
    padding-block: clamp(48px, 8vw, 96px);
  }
  .pl-section {
    border-top: 1px solid var(--border);
  }
  .eyebrow {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 20px;
  }
  h1,
  h2 {
    font-family:
      "Iowan Old Style", "Charter", "Noto Sans TC Variable", Georgia, serif;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  h1 {
    font-size: clamp(44px, 6vw, 76px);
    line-height: 1.04;
    margin: 0 0 20px;
  }
  h2 {
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.1;
    margin: 0 0 28px;
  }
  h3 {
    font-size: 21px;
    font-weight: 600;
    margin: 0 0 6px;
  }
  .lead {
    font-size: 19px;
    line-height: 1.55;
    color: color-mix(in oklch, var(--foreground) 80%, transparent);
    max-width: 60ch;
    margin: 0 0 32px;
  }
  .note {
    font-size: 13px;
    color: color-mix(in oklch, var(--foreground) 80%, transparent);
    margin-top: 20px;
  }
  .pl-hero-split {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }
  a.btn-primary,
  a.btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 12px 20px;
    border-radius: 10px;
    border: 1px solid transparent;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }
  a.btn-primary {
    background: var(--accent);
    color: var(--background);
    border-color: var(--accent);
  }
  a.btn-primary:hover {
    background: color-mix(in oklch, var(--accent) 86%, black);
  }
  a.btn-ghost {
    color: var(--foreground);
    padding-inline: 8px;
  }
  a.btn-ghost:hover {
    color: var(--accent);
  }
  .portrait-frame {
    position: relative;
  }
  .portrait {
    width: 100%;
    height: auto;
    border-radius: 16px;
    border: 1px solid var(--border);
  }
  .portrait-chip {
    position: absolute;
    left: 14px;
    bottom: 14px;
    background: color-mix(in oklch, var(--background) 84%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border);
    color: var(--foreground);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 8px 13px;
    border-radius: 999px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
  .stat-num {
    font-family: "Iowan Old Style", "Noto Sans TC Variable", Georgia, serif;
    font-size: clamp(52px, 7vw, 84px);
    line-height: 0.95;
    letter-spacing: -0.04em;
    font-weight: 600;
  }
  .stat-unit {
    font-size: 0.5em;
    opacity: 0.6;
    margin-left: 2px;
  }
  .stat-label {
    color: color-mix(in oklch, var(--foreground) 80%, transparent);
    font-size: 14px;
    margin-top: 10px;
    max-width: 26ch;
  }
  .work-split {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 56px;
    align-items: start;
  }
  .decisions {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: grid;
    gap: 14px;
  }
  .decisions li {
    position: relative;
    padding-left: 20px;
    color: color-mix(in oklch, var(--foreground) 80%, transparent);
    font-size: 15px;
    line-height: 1.5;
  }
  .decisions li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    width: 6px;
    height: 6px;
    border: 1px solid currentColor;
    border-radius: 1px;
  }
  .decisions strong {
    color: var(--foreground);
    font-weight: 600;
  }
  .facts {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 28px;
  }
  .facts dl {
    display: grid;
    gap: 20px;
    margin: 0;
  }
  .facts dt {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in oklch, var(--foreground) 80%, transparent);
  }
  .facts dd {
    margin: 5px 0 0;
    font-size: 15px;
  }
  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .work-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 28px;
    color: inherit;
    text-decoration: none;
  }
  .work-card h3 {
    font-family: "Iowan Old Style", "Noto Sans TC Variable", Georgia, serif;
    font-size: 24px;
  }
  .work-card p {
    margin: 0;
    color: color-mix(in oklch, var(--foreground) 80%, transparent);
    font-size: 15px;
  }
  .work-card .metric {
    color: var(--foreground);
    font-size: 14px;
    font-weight: 500;
    margin-top: auto;
    padding-top: 20px;
  }
  .pill,
  .tag {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    font-size: 12px;
    padding: 5px 11px;
    white-space: nowrap;
  }
  .pill {
    background: color-mix(in oklch, var(--foreground) 6%, transparent);
    color: color-mix(in oklch, var(--foreground) 80%, transparent);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .tag {
    border: 1px solid var(--border);
    color: color-mix(in oklch, var(--foreground) 80%, transparent);
  }
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .feature h3 {
    font-family: "Iowan Old Style", "Noto Sans TC Variable", Georgia, serif;
  }
  .feature p {
    margin: 0;
    color: color-mix(in oklch, var(--foreground) 80%, transparent);
    font-size: 15px;
  }
  .log-row {
    display: grid;
    grid-template-columns: 130px 1fr 110px;
    gap: 32px;
    padding: 22px 0;
    border-top: 1px solid var(--border);
    align-items: baseline;
  }
  .log-row .meta {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 13px;
    color: color-mix(in oklch, var(--foreground) 80%, transparent);
  }
  .log-row h3 {
    font-size: 19px;
  }
  .log-row h3 a {
    text-decoration: none;
    color: inherit;
  }
  .log-row h3 a:hover {
    color: var(--accent);
  }
  .log-row .dek {
    margin: 5px 0 0;
    color: color-mix(in oklch, var(--foreground) 80%, transparent);
    font-size: 14px;
  }
  .log-row .pull {
    text-align: right;
  }
  .head-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 32px;
  }
  .head-row h2 {
    margin-bottom: 0;
  }
  .cta-strip {
    text-align: center;
  }
  .cta-strip .eyebrow {
    margin-bottom: 16px;
  }
  .cta-strip .lead {
    margin-inline: auto;
  }
  :lang(zh) h1 {
    line-height: 1.25;
  }
  :lang(zh) h2 {
    line-height: 1.3;
  }
  @media (max-width: 920px) {
    .pl-hero-split,
    .work-split,
    .stats,
    .work-grid,
    .feature-grid {
      grid-template-columns: 1fr;
    }
    .log-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .log-row .pull {
      text-align: left;
    }
  }
</style>
