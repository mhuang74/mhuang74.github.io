---
// Showcase demo: interactive explorer for Stream of Worship's songset
// constructor. Dataset is imported verbatim from the repo's eval harness
// output (eval/run1_standard/proposals.json) at build time — no hand-copied
// numbers. Vanilla is:inline script — no framework, no CDN dependencies.
import proposalsJson from "@/assets/sow-songset-run1-standard.json";

const PHASES: Record<string, string> = {
  "1": "Praise 讚美",
  "2": "Thanksgiving 感恩",
  "3": "Worship 敬拜",
  "4": "Offering 奉獻",
  "5": "Sending 差遣",
};

// Deterministic pseudo-random waveforms seeded per song so the shapes are
// stable across renders. No audio is shipped (repo gitignores media); these
// bars are illustrative only — surfaced in the UI via the SYNTHETIC_WAVE_NOTE.
function makePeaks(seed: string, n: number): number[] {
  let h = 2166136261;
  for (const c of seed) {
    h = Math.imul(h ^ c.charCodeAt(0), 16777619);
  }
  function next(): number {
    h = Math.imul(h ^ (h >>> 15), 2246822519);
    h ^= h >>> 13;
    return (h >>> 0) / 4294967295;
  }
  const out: number[] = [];
  for (let i = 0; i < n; i++) {
    out.push(Math.min(1, 0.25 + Math.abs(next()) * 0.75));
  }
  return out;
}

const run = proposalsJson as {
  run_id: string;
  proposals: Array<{
    rank: number;
    items: Array<{
      position: number;
      title: string;
      key: string;
      mode: string;
      bpm: number;
      phase: number;
      key_confidence: number;
      crossfade_duration_seconds: number;
      key_shift_semitones: number;
    }>;
    score: Record<string, number>;
  }>;
};

const proposals = run.proposals.map(p => {
  return {
    rank: p.rank,
    score: {
      theme: p.score.f_theme,
      tempo: p.score.f_tempo,
      harmony: p.score.f_harmony,
      diversity: p.score.f_diversity,
      total: p.score.total,
    },
    items: p.items.map(it => {
      return {
        title: it.title,
        key: it.key,
        mode: it.mode,
        bpm: it.bpm,
        phase: it.phase,
        confidence: it.key_confidence,
        crossfade: it.crossfade_duration_seconds || null,
        shift: it.key_shift_semitones,
        peaks: makePeaks(it.title + it.key, 48),
      };
    }),
    phasePath: p.items.map(it => PHASES[String(it.phase)] ?? `Phase ${it.phase}`),
  };
});

const RUN_ID = run.run_id;
const SYNTHETIC_WAVE_NOTE =
  "Waveform bars are synthetic placeholders — no audio is shipped. Song, key, BPM, crossfade, and score values are verbatim constructor output.";
---

<div
  id="sow-showcase"
  class="not-prose my-8 rounded-lg border border-border"
  data-proposals={JSON.stringify(proposals)}
>
  <div
    class="flex flex-wrap items-center justify-between gap-2 border-b border-border px-4 py-3"
  >
    <p class="font-mono text-xs tracking-widest text-foreground/60 uppercase">
      Showcase — songset constructor output
    </p>
    <p class="font-mono text-xs text-foreground/60">
      run <em>{RUN_ID}</em>
    </p>
  </div>

  <div class="p-4">
    <div
      class="flex gap-2"
      role="tablist"
      aria-label="Proposed songsets, ranked"
    >
      {
        proposals.map((p, i) => (
          <button
            type="button"
            role="tab"
            data-idx={i}
            aria-selected={i === 0 ? "true" : "false"}
            class:list={[
              "sow-tab cursor-pointer rounded-md border border-border px-3 py-2 font-mono text-xs",
              i === 0 && "border-accent/60 bg-accent/10",
            ]}
          >
            <span class="block text-[10px] tracking-widest text-foreground/60 uppercase">
              Rank {p.rank}
            </span>
            <span class="block text-sm font-medium">score {p.score.total}</span>
          </button>
        ))
      }
    </div>

    <div id="sow-lanes" class="mt-4 flex flex-col gap-3"></div>

    <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-5" id="sow-scores">
    </div>

    <p class="mt-3 font-mono text-[10px] leading-relaxed text-foreground/50">
      {SYNTHETIC_WAVE_NOTE}
    </p>

    <noscript>
      <div class="mt-4 space-y-3">
        <p class="text-sm text-foreground/80">
          JavaScript is disabled — the ranked proposals are:
          {
            proposals.map(p => (
              <span>
                <br />
                {p.rank}) <strong>{p.items.map(i => i.title).join(" → ")}</strong>{" "}
                (score {p.score.total})
              </span>
            ))
          }
          . The full scored detail is in the repo's
          <code>eval/run1_standard/proposals.json</code>.
        </p>
      </div>
    </noscript>
  </div>

  <script is:inline data-astro-rerun define:vars={{ }}>
    (function () {
      const root = document.getElementById("sow-showcase");
      if (!root) return;
      let proposals;
      try {
        proposals = JSON.parse(root.dataset.proposals || "[]");
      } catch {
        return;
      }

      // Guard against double-binding across ClientRouter re-runs.
      if (root.dataset.sowInit === "1") return;
      root.dataset.sowInit = "1";

      const lanes = root.querySelector("#sow-lanes");
      const scores = root.querySelector("#sow-scores");
      const tabs = root.querySelectorAll(".sow-tab");
      // Read theme accent once per render so light/dark toggles stay correct.
      const accent = () => {
        const v = getComputedStyle(document.documentElement)
          .getPropertyValue("--accent")
          .trim();
        return v || "#b34104";
      };

      const SCORE_LABELS = [
        ["theme", "Theme fit"],
        ["tempo", "Tempo flow"],
        ["harmony", "Harmonic mix"],
        ["diversity", "Diversity"],
        ["total", "Composite"],
      ];

      function laneSvg(peaks) {
        const w = 240;
        const h = 44;
        const mid = h / 2;
        const barW = w / peaks.length;
        let rects = "";
        for (let i = 0; i < peaks.length; i++) {
          const amp = peaks[i] * mid;
          rects += '<rect x="' + (i * barW).toFixed(1) + '" y="' + (mid - amp).toFixed(1) + '" width="' + (barW * 0.62).toFixed(1) + '" height="' + (amp * 2).toFixed(1) + '" rx="0.5" fill="currentColor" opacity="0.55"/>';
        }
        return '<svg viewBox="0 0 ' + w + " " + h + '" class="h-11 w-full" aria-hidden="true">' + rects + "</svg>";
      }

      function transitionNote(prev, next) {
        if (next.crossfade) {
          return next.crossfade + "s crossfade · shifts +" + next.shift + " semitone into " + next.key;
        }
        return prev.key + " " + prev.mode + " · " + prev.bpm + " → " + next.key + " " + next.mode + " · " + next.bpm + " BPM";
      }

      function renderProposal(idx) {
        const p = proposals[idx];
        if (!p) return;

        lanes.innerHTML = "";
        p.items.forEach((it, i) => {
          const row = document.createElement("div");
          row.className =
            "grid grid-cols-[7rem_1fr] items-center gap-3 sm:grid-cols-[10rem_1fr_12rem]";
          row.innerHTML =
            '<div>' +
            '<p class="text-sm font-medium leading-tight">' + it.title + "</p>" +
            '<p class="font-mono text-[10px] text-foreground/60">Phase ' + it.phase + " · " + it.key + " " + it.mode + "</p>" +
            "</div>" +
            '<div class="text-accent">' + laneSvg(it.peaks) + "</div>" +
            '<div class="col-span-2 font-mono text-[11px] leading-snug text-foreground/70 sm:col-span-1">' +
            it.bpm + " BPM · key conf. " + (it.confidence * 100).toFixed(0) + "%" +
            (i > 0
              ? '<br><span class="text-accent">→ in:</span> ' + transitionNote(p.items[i - 1], it)
              : "") +
            "</div>";
          lanes.appendChild(row);
        });

        scores.innerHTML = "";
        for (const pair of SCORE_LABELS) {
          const key = pair[0];
          const label = pair[1];
          const val = p.score[key];
          const cell = document.createElement("div");
          cell.className = "rounded-md bg-muted/50 px-3 py-2";
          cell.innerHTML =
            '<p class="font-mono text-[10px] tracking-widest text-foreground/60 uppercase">' + label + "</p>" +
            '<p class="font-mono text-sm font-medium">' + Number(val).toFixed(3) + "</p>";
          scores.appendChild(cell);
        }

        tabs.forEach((t, i) => {
          t.setAttribute("aria-selected", String(i === idx));
          t.classList.toggle("border-accent/60", i === idx);
          t.classList.toggle("bg-accent/10", i === idx);
        });

        // Waveform bars use currentColor — refresh in case the theme toggled.
        root.style.color = accent();
      }

      tabs.forEach((t, i) =>
        t.addEventListener("click", () => renderProposal(i))
      );

      // Re-tint waveforms on theme toggle (attribute change on <html>).
      const themeObserver = new MutationObserver(() => {
        const selected = Array.prototype.findIndex.call(
          tabs,
          t => t.getAttribute("aria-selected") === "true"
        );
        renderProposal(selected >= 0 ? selected : 0);
      });
      themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });

      renderProposal(0);
    })();
  </script>
</div>
