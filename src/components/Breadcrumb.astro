---
import { getLocaleFromPath, localizePath, stripLocale } from "@/i18n/locale";
import { getTagLabel } from "@/i18n/tagLabels";
import { format, t, type MessageKey } from "@/i18n/ui";

const locale = getLocaleFromPath(Astro.url.pathname);

// Remove current url path and remove trailing slash if exists
const currentUrlPath = stripLocale(Astro.url.pathname).replace(/\/+$/, "");

// Get url array from path
// eg: /tags/tailwindcss => ['tags', 'tailwindcss']
const breadcrumbList = currentUrlPath.split("/").slice(1);

const knownSegments: Record<string, MessageKey> = {
  posts: "breadcrumb.posts",
  work: "breadcrumb.work",
  about: "breadcrumb.about",
  tags: "breadcrumb.tags",
  search: "breadcrumb.search",
  archives: "breadcrumb.archives",
};

interface Crumb {
  label: string;
  href?: string;
}

const segmentLabel = (segment: string, index: number): string => {
  if (locale === "en") return segment;
  if (index === 1 && breadcrumbList[0] === "tags") {
    return getTagLabel(locale, decodeURIComponent(segment));
  }
  const key = knownSegments[segment];
  return key ? t(locale, key) : segment;
};

const crumbs: Crumb[] = (() => {
  // if breadcrumb is Home > Posts > 1 <etc>
  // replace Posts with Posts (page number)
  if (breadcrumbList[0] === "posts") {
    const n = breadcrumbList[1] || 1;
    const page = format(t(locale, "breadcrumb.page"), { n });
    return [
      {
        label:
          locale === "en"
            ? `${t(locale, "breadcrumb.posts")} ${page}`
            : `${t(locale, "breadcrumb.posts")}${page}`,
      },
    ];
  }

  // if breadcrumb is Home > Tags > [tag] > [page] <etc>
  // replace [tag] > [page] with [tag] (page number)
  if (breadcrumbList[0] === "tags" && !isNaN(Number(breadcrumbList[2]))) {
    const n = Number(breadcrumbList[2]);
    const tag = getTagLabel(
      locale,
      decodeURIComponent(breadcrumbList[1] ?? "")
    );
    const page = format(t(locale, "breadcrumb.page"), { n });
    return [
      {
        label: t(locale, "breadcrumb.tags"),
        href: `${localizePath("/tags", locale)}/`,
      },
      {
        label:
          n === 1
            ? locale === "en"
              ? `${tag} `
              : tag
            : locale === "en"
              ? `${tag} ${page}`
              : `${tag}${page}`,
      },
    ];
  }

  return breadcrumbList.map((segment, index) => ({
    label: segmentLabel(segment, index),
    href:
      index + 1 === breadcrumbList.length
        ? undefined
        : localizePath("/" + segment, locale) + "/",
  }));
})();
---

<nav
  class="mx-auto mt-8 mb-1 w-full max-w-app px-4"
  aria-label={t(locale, "breadcrumb.label")}
>
  <ul
    class="font-light [&>li]:inline [&>li:not(:last-child)>a]:hover:opacity-100"
  >
    <li>
      <a href={localizePath("/", locale)} class="opacity-80"
        >{t(locale, "breadcrumb.home")}</a
      >
      <span aria-hidden="true" class="opacity-80">&raquo;</span>
    </li>
    {
      crumbs.map((crumb, index) =>
        index + 1 === crumbs.length ? (
          <li>
            <span
              class:list={["capitalize opacity-75", { lowercase: index > 0 }]}
              aria-current="page"
            >
              {crumb.label}
            </span>
          </li>
        ) : (
          <li>
            <a href={crumb.href} class="capitalize opacity-70">
              {crumb.label}
            </a>
            <span aria-hidden="true">&raquo;</span>
          </li>
        )
      )
    }
  </ul>
</nav>
