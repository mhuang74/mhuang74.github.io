---
interface Props {
  title: string;
  role: string;
  stack?: string[];
  outcome?: string;
  href: string;
  description: string;
}

const { title, role, stack = [], outcome, href, description } = Astro.props;

// Placeholder outcomes (owner metrics pending) must not render on cards.
const showOutcome = outcome && !outcome.startsWith("[METRIC NEEDED");
---

<a
  href={href}
  class="group block rounded-lg border border-border p-6 no-underline transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/60 hover:shadow-lg"
>
  <p class="font-mono text-xs tracking-widest text-accent uppercase">{role}</p>
  <h3
    class="mt-2 text-xl font-semibold text-foreground decoration-accent decoration-2 underline-offset-4 group-hover:underline"
  >
    {title}
  </h3>
  <p class="mt-2 text-sm leading-relaxed text-foreground/80">{description}</p>
  {
    showOutcome && (
      <p class="mt-3 font-mono text-sm text-foreground/90">
        <span class="mr-2 inline-block h-2 w-2 rounded-full bg-accent align-middle" />
        {outcome}
      </p>
    )
  }
  {
    stack.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {stack.map(s => (
          <li class="rounded-full bg-muted px-2.5 py-0.5 font-mono text-xs text-foreground/80">
            {s}
          </li>
        ))}
      </ul>
    )
  }
</a>
