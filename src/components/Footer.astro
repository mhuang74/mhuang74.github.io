---
import Hr from "./Hr.astro";
import Socials from "./Socials.astro";
import { getLocaleFromPath, localizePath } from "@/i18n/locale";
import { t } from "@/i18n/ui";

const currentYear = new Date().getFullYear();
const locale = getLocaleFromPath(Astro.url.pathname);

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class:list={["w-full", { "mt-auto": !noMarginTop }]}>
  <Hr noPadding />
  <div
    class="flex flex-col items-center justify-between py-6 sm:flex-row-reverse sm:py-4"
  >
    <Socials centered />
    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row">
      <span>Copyright &#169; {currentYear}</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span>{t(locale, "footer.rights")}</span>
    </div>
    <nav aria-label={t(locale, "footer.label")} class="mb-2 sm:mb-0">
      <ul class="flex gap-4 font-mono text-sm">
        <li>
          <a href={localizePath("/tags", locale)} class="hover:text-accent">
            {t(locale, "tags.title")}
          </a>
        </li>
        <li>
          <a href={localizePath("/archives", locale)} class="hover:text-accent">
            {t(locale, "breadcrumb.archives")}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</footer>
