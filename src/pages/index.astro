<script>
  // GA4 event tracking for CTA clicks. The site's GA bootstrap (GoogleAnalytics.astro)
  // is IIFE-wrapped, so `gtag` is not exposed on window; define the snippet-standard
  // shim locally. gtag.js's dataLayer handler only dispatches Arguments objects
  // (an array is read as a dotted model path and never fires), so the regular
  // function + `arguments` form is required — `dataLayer.push(["event", …])` would
  // silently no-op.
  type DlWindow = Window & { __ctaClickWired?: boolean; dataLayer?: unknown[] };
  const dlWindow = window as DlWindow;
  if (!dlWindow.__ctaClickWired) {
    dlWindow.__ctaClickWired = true;
    // eslint-disable-next-line @typescript-eslint/no-unused-vars -- rest param exists only to allow the 3-arg call
    function gtag(..._args: unknown[]): void {
      // eslint-disable-next-line prefer-rest-params -- Arguments object is the required message form for gtag.js
      (dlWindow.dataLayer = dlWindow.dataLayer || []).push(arguments);
    }
    document.addEventListener("click", e => {
      const el = (e.target as Element | null)?.closest?.("[data-cta]");
      if (!el) return;
      gtag("event", "cta_click", {
        target: el.getAttribute("data-cta"),
        location: el.getAttribute("data-cta-location"),
      });
    });
  }
</script>

