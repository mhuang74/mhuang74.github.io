---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import TechStackCard from "@/components/TechStackCard.astro";
import WorkCard from "@/components/WorkCard.astro";
import Hr from "@/components/Hr.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const allWorks = await getCollection("work");
const featuredWorks = allWorks.filter(({ data }) => data.featured);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index">
    <section id="hero" class="pt-12 pb-10 sm:pt-16">
      <p
        class="font-mono text-xs tracking-widest text-accent uppercase sm:text-sm"
      >
        Product Manager · Builder
      </p>
      <h1
        class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-5xl"
      >
        Product Manager who navigates technical shallows and builds products end
        to end.
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-foreground/80">
        When customers ask for Faster Horses, I focus on their core frustrations
        and solve the ones that don't drag in expensive technical risks. I'm
        Michael Huang and I ship the products I manage. I have led products
        ranging from audio-analysis and lyrics time-coding automation to Google
        Ads analyst skills, anomaly reports, analytics dashboards, and
        business-critical ETL pipelines.
      </p>
      <LinkButton
        href="/work"
        class="mt-6 inline-flex items-center gap-1 rounded-md border border-accent/60 px-4 py-2 font-medium text-accent hover:bg-accent/10"
      >
        See my work
        <IconArrowRight class="h-4 w-4" />
      </LinkButton>
    </section>

    {
      featuredWorks.length > 0 && (
        <>
          <Hr />
          <section id="featured-work" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">Featured Work</h2>
            <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {featuredWorks.map(({ id, data }) => (
                <WorkCard
                  title={data.title}
                  role={data.role}
                  stack={data.stack.slice(0, 4)}
                  outcome={data.outcomes[0]}
                  description={data.description}
                  href={`/work/${id}`}
                />
              ))}
            </div>
            <div class="mt-6 text-right">
              <LinkButton
                href="/work"
                class="hover:text-accent"
                ariaLabel="all work"
                title="All Work"
              >
                All Work
                <IconArrowRight class="inline-block h-4 w-4" />
              </LinkButton>
            </div>
          </section>
        </>
      )
    }

    <Hr />

    <section id="focus-areas" class="pt-12 pb-6">
      <h2 class="text-3xl font-bold text-foreground sm:text-4xl">
        Focus Areas
      </h2>
      <p class="mt-2 mb-8 text-foreground/70">
        Domains I've designed, built, and managed products in.
      </p>
      <div class="grid gap-6 sm:grid-cols-2">
        <TechStackCard
          title="Machine Learning"
          description="time-series anomaly detection · forecasting · Python · Pandas · NumPy · scikit-learn · Jupyter"
        />
        <TechStackCard
          title="Agents & RAG Search"
          description="LangGraph Agentic Loops · RAG-enhanced query generation · LanceDB · pgvector"
        />
        <TechStackCard
          title="Data Engineering"
          description="Spark ETL pipelines · Avro · ORC · Parquet · Trino"
        />
        <TechStackCard
          title="Data Analytics & Dashboards"
          description="AWS Quicksight · Athena · EMR · Lambda · S3"
        />
        <TechStackCard
          title="Distributed & Reactive Microservices"
          description="Kafka · Akka · Scala/Java"
        />
        <TechStackCard
          title="Product Management"
          description="Jobs-to-be-Done · roadmaps · stakeholder management · team leadership"
        />
        <TechStackCard
          title="Growth & Marketing Analytics"
          description="Google Ads · conversion attribution · marketing automation"
        />
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <>
          <Hr />
          <section id="featured-writing" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
            <ul>
              {featuredPosts.map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          </section>
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <>
          <Hr />
          <section id="recent-posts" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">Recent Writing</h2>
            <ul>
              {recentPosts.map(
                (data, index) =>
                  index < SITE.postPerIndex && <Card variant="h3" {...data} />
              )}
            </ul>
          </section>
        </>
      )
    }

    <Hr />

    <section id="about-teaser" class="pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">About</h2>
      <p class="mt-3 max-w-2xl leading-relaxed text-foreground/80">
        I've spent my career where product decisions meet hard technical
        constraints — data platforms, ML systems, and most recently LLM tooling.
        I still write code and ship infrastructure for the products I manage,
        because the best product judgment comes from knowing what the work
        actually costs.
      </p>
      <LinkButton
        href="/about"
        class="mt-4 inline-flex items-center gap-1 font-medium text-accent hover:underline"
        ariaLabel="read more about me"
        title="Read more about me"
      >
        Read more about me
        <IconArrowRight class="h-4 w-4" />
      </LinkButton>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
