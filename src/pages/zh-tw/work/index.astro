---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import WorkCard from "@/components/WorkCard.astro";
import { SITE } from "@/config";
import { getLocaleFromPath } from "@/i18n/locale";
import { t } from "@/i18n/ui";
import { getWorkHref } from "@/utils/entryPath";

const locale = getLocaleFromPath(Astro.url.pathname);
const works = await getCollection("workZhTw");
const sorted = works.sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured)
);
---

<Layout title={`${t(locale, "work.title")} | ${SITE.title}`}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="mx-auto w-full max-w-app px-4 pb-12">
    <section id="work" class="pt-4 pb-6">
      <h1 class="text-2xl font-semibold tracking-wider sm:text-3xl">
        {t(locale, "work.title")}
      </h1>
      <p class="mt-2 mb-8 text-foreground/70">
        {t(locale, "work.desc")}
      </p>
      <div class="grid gap-6 sm:grid-cols-2">
        {
          sorted.map(entry => (
            <WorkCard
              title={entry.data.title}
              role={entry.data.role}
              stack={entry.data.stack}
              outcome={entry.data.outcomes[0]}
              description={entry.data.description}
              href={getWorkHref(entry)}
            />
          ))
        }
      </div>
    </section>
  </main>
  <Footer />
</Layout>
