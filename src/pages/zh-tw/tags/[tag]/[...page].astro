---
import type { GetStaticPathsOptions } from "astro";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import { getZhListing } from "@/i18n/blog";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { getTagLabel } from "@/i18n/tagLabels";
import { format, t } from "@/i18n/ui";
import { SITE } from "@/config";

const locale = "zh-tw";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const listing = await getZhListing();
  const posts = listing.map(item => item.entry);
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag }) => {
    const tagPosts = getPostsByTag(posts, tag);

    return paginate(tagPosts, {
      params: { tag },
      pageSize: SITE.postPerPage,
    });
  });
}

const { tag = "" } = Astro.params;
const { page } = Astro.props;
const tagLabel = getTagLabel(locale, tag);
const pageTitle = format(t(locale, "tags.tagTitle"), { name: tagLabel });
const pageDesc = format(t(locale, "tags.tagDesc"), { name: tagLabel });
---

<Layout
  title={`${pageTitle} | ${SITE.title}`}
  alternates={page.currentPage === 1 ? undefined : null}
>
  <Header />
  <Main pageTitle={pageTitle} titleTransition={tag} {pageDesc}>
    <h1 slot="title" transition:name={tag}>{pageTitle}</h1>
    <ul>
      {
        page.data.map(entry => (
          <Card
            {...entry}
            badge={
              entry.collection === "blog"
                ? t(locale, "post.englishBadge")
                : undefined
            }
          />
        ))
      }
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
