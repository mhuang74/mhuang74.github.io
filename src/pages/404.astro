---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { SITE } from "@/config";
---

<Layout title={`404 Not Found | ${SITE.title}`}>
  <Header />

  <main
    id="main-content"
    class="mx-auto flex max-w-app flex-1 items-center justify-center"
  >
    <script is:inline>
      const REDIRECTS = {
        "/blog/": "/posts/",
        "/blog/2022_plans/": "/posts/2022-plans/",
        "/blog/qsv_lessons/": "/posts/qsv-lessons/",
        "/blog/quick_look_at_charts/": "/posts/quick-look-at-charts/",
        "/blog/test_table/": "/posts/test-table/",
        "/blog/google_asset_based_ad_extensions/":
          "/posts/google-asset-based-ad-extensions/",
        "/apps/": "/posts/handsoff/",
        "/apps/handsoff/": "/posts/handsoff/",
      };
      let p = location.pathname;
      if (!p.endsWith("/")) p += "/";
      let target = REDIRECTS[p];
      if (!target && p.startsWith("/categories/")) {
        target = "/tags/" + p.slice("/categories/".length);
      }
      if (target) location.replace(new URL(target, location.origin).href);
    </script>
    <div class="mb-14 flex flex-col items-center justify-center">
      <h1 class="text-9xl font-bold text-accent">404</h1>
      <span aria-hidden="true">¯\_(ツ)_/¯</span>
      <p class="mt-4 text-2xl sm:text-3xl">Page Not Found</p>
      <LinkButton
        href="/"
        class="my-6 text-lg underline decoration-dashed underline-offset-8"
      >
        Go back home
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>
